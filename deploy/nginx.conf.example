# /etc/nginx/sites-available/supbot
# Danach:  ln -s /etc/nginx/sites-available/supbot /etc/nginx/sites-enabled/
#          certbot --nginx -d supplements.deine-domain.de
#          nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name supplements.deine-domain.de;

    # Mit zentralem Login (authgate, nach certbot im 443-Block):
    #   include /etc/nginx/snippets/authgate.conf;
    #   location = /healthz    { auth_request off; proxy_pass http://127.0.0.1:8080; }
    #   location ^~ /zentrale/ { auth_request off; proxy_pass http://127.0.0.1:8080; }
    # und SUPBOT_AUTHGATE_URL=http://127.0.0.1:9180/check in .env (siehe README).

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

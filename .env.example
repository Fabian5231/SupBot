# ---- SupBot Konfiguration -------------------------------------------------
# Kopieren nach .env und ausfuellen:  cp .env.example .env

# Telegram Bot Token von @BotFather, Format 123456789:AAE-xxxxxxxxxxxxxxxxxxxx
SUPBOT_TELEGRAM_TOKEN=

# Deine Chat-ID. Leer lassen und dem Bot einmal /start schreiben,
# dann traegt er sich selbst ein.
SUPBOT_TELEGRAM_CHAT_ID=

# Passwort fuer die Weboberflaeche (leer = kein Login, nur fuer lokale Tests!)
SUPBOT_PASSWORD=

# Zufaelliger String zum Signieren des Login-Cookies
# erzeugen mit:  python -c "import secrets;print(secrets.token_hex(32))"
SUPBOT_SECRET=

# Zeitzone
SUPBOT_TZ=Europe/Berlin

# Bind-Adresse / Port
SUPBOT_HOST=127.0.0.1
SUPBOT_PORT=8080

# Ablage der SQLite-Datenbank
SUPBOT_DATA_DIR=./data

# ---- Gewicht --------------------------------------------------------------
# Pfad zur Tesseract-Binary. Leer = automatisch suchen (PATH bzw. Standard-
# Installationsorte unter Windows).
SUPBOT_TESSERACT_CMD=

# Sprachdaten fuer den Tesseract-Rueckfall. Leer = das mitgelieferte Modell
# ssd fuer Sieben-Segment-Anzeigen. Bei einer Waage mit normaler Schrift statt
# Leuchtbalken hier eng eintragen.
SUPBOT_TESSERACT_LANG=

# Plausibilitaetsgrenzen, filtern Fehlerkennungen weg
SUPBOT_WEIGHT_MIN_KG=30
SUPBOT_WEIGHT_MAX_KG=250

# 0 = Fotos nach der Erkennung verwerfen, nur die Zahl behalten
SUPBOT_KEEP_IMAGES=1
